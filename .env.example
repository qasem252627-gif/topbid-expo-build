# Manus OAuth/session credentials are provided by the managed runtime.
# Firebase Phone Auth sends SMS from the app's Firebase SDK; the backend only verifies its ID token.
# Keep real SMS mode enabled for production builds; set this to true only for Firebase test numbers.
EXPO_PUBLIC_FIREBASE_PHONE_AUTH_TEST_MODE=false

# Optional: explicit Firebase project ID; defaults to firebase-web-config.json projectId.
FIREBASE_AUTH_PROJECT_ID=topbid-c54fd
